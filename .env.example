# Copy to .env and fill placeholders only. NEVER commit real keys.

# fal.ai — required for almost all image / video / audio generation
# https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# xAI / Grok — optional (Enhance Prompt / Grok text). Imagine models on fal still use FAL_KEY.
# https://console.x.ai/team/default/api-keys
XAI_KEY=your_xai_key_here
# XAI_API_KEY is also accepted (V1 name).

# Runware — optional (Aleph / Frame Editor only; never used for fal routes)
# https://my.runware.ai/
RUNWARE_KEY=your_runware_key_here
# RUNWARE_API_KEY is also accepted.

# Optional overrides
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5

# ---------------------------------------------------------------------------
# Resolve handoff (receive). Send uses the Resolve scripting API, not a folder.
# Production: set these in Settings (blank = disabled). Do not bake machine paths.
# ---------------------------------------------------------------------------
# RESOLVE_INBOX=
# RESOLVE_HANDOFF is accepted as an alias of RESOLVE_INBOX.
# AI_MEDIA_STUDIO_ROOT=
#   (inbox becomes <root>/data/resolve_handoff)
# In a checkout, if unset, V2 may look at sibling ../ai-media-studio/data/resolve_handoff.

# AMS_DEV=1  force checkout-relative outputs/data
# AMS_DEV=0  force portable data under %LOCALAPPDATA%\AI Media Studio V2

